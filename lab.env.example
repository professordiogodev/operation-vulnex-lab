# Copy this file to lab.env and set LHOST before generating payloads:
#     cp lab.env.example lab.env
#
# RHOST / RPORT — where DVWA listens, as seen from your attacker box.
RHOST=localhost
RPORT=42080

# LHOST — where the TARGET calls back to YOU. This is the #1 thing people get wrong.
# Run ./scripts/00-setup.sh and it prints the right value for your machine.
#
#   Windows WSL2 / Linux / Kali, with Docker running INSIDE the distro
#                                      -> docker0 gateway (usually 172.17.0.1)  <-- most students
#   macOS + OrbStack / Docker Desktop  -> host.docker.internal as seen INSIDE the
#                                         container, e.g. 0.250.250.254. Find it with:
#                                         docker exec dvwa getent hosts host.docker.internal
#   Attacker and DVWA on separate VMs  -> your attacker IP (ip addr)
# Never use 127.0.0.1 here: the container cannot reach your loopback.
# The kit's 2x-handler scripts bind 0.0.0.0, so this value only needs to be reachable.
LHOST=172.17.0.1

# Callback ports (keep the two phases distinct).
LPORT_CMD=4444
LPORT_PHP=4445
